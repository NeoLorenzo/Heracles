{
  "issue": 22,
  "title": "Canonical exercise identity independent of equipment",
  "date": "2026-10-17",
  "decision": "Exercise names no longer encode the implement or machine used. Equipment is recorded separately on each performed exercise. Exercises that differed only by equipment are merged into one canonical exercise; the surviving catalogue row keeps its stable code and identifier, merged rows are retired (is_active = false) with their original names and historical coefficients intact.",
  "movementModelDecision": "Each canonical exercise inherits the full movement-pattern vector of its scoring source unchanged, except the two machine incline chest presses, which receive the same isometric scapulothoracic retraction (0.4) and depression (0.25) coefficients as every bench and Smith chest press.",
  "movementAlignmentRationale": "In a supported chest press the scapulae are held retracted and depressed against the pad whether the lifter lies on a bench or sits on a machine, so the isometric scapular contribution applies to both. The previous zero on the machine incline rows was inconsistent with the bench and machine flat-press decision approved on 2026-10-17.",
  "mergedScoringDecisions": [
    {
      "canonicalName": "Chest Press",
      "source": "Press (Barbell)",
      "dropped": [
        "Press (Cable) (Horizontal): dynamic scapulothoracic protraction 0.4 and serratus anterior relevance 0.25",
        "Press (Machine) (Horizontal) and (Plate Loaded): no isometric retraction/depression"
      ],
      "reason": "Flat pressing on a bench or a seated machine is one movement; the bench scoring (scapulae held back and down) is used by 20 of the 24 chest-press variants."
    },
    {
      "canonicalName": "Row (Chest Supported) (Wide Grip)",
      "source": "Row (T-Bar) (Chest Supported) (Wide-Grip)",
      "dropped": [
        "Row (Machine) (Chest Supported) (Wide Grip): isometric lumbar extension 0.2"
      ],
      "reason": "Every other chest-supported row scores isometric lumbar extension 0; with the torso on a pad the lumbar spine is not holding the trunk upright."
    },
    {
      "canonicalName": "Row (Close Grip)",
      "source": "Row (Cable Machine) (Close Grip)",
      "dropped": [
        "Row (Machine) (Close Grip): isometric lumbar extension 0.2"
      ],
      "reason": "Without chest support the lumbar extensors hold the trunk upright (0.3); padded variants are the separate Chest Supported exercises."
    },
    {
      "canonicalName": "Row (Close Grip) (Unilateral)",
      "source": "Row (Cable Machine) (Close Grip) (Unilateral)",
      "dropped": [
        "Row (Machine) (Close Grip) (Unilateral): isometric lumbar extension 0.2"
      ],
      "reason": "Same as Row (Close Grip)."
    }
  ],
  "hypertrophicRelevanceDecision": "Each canonical exercise inherits the authored relevance vector of its scoring source unchanged. No relevance coefficient is invented or edited.",
  "equipmentInference": "Performed exercises with no recorded equipment receive the equipment their previous exercise name stated: Dumbbell, Barbell, EZ Bar and Bodyweight are generic equipment; Machine, Cable, Smith Machine, Leg Press, Pec Deck and T-Bar become a per-gym '<Type> (unknown model)' placeholder to be corrected with the real model.",
